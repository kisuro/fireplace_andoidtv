<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <size
                android:width="22dp"
                android:height="22dp" />
            <solid android:color="@color/fireplace_focus" />
            <stroke
                android:width="2dp"
                android:color="@color/fireplace_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size
                android:width="18dp"
                android:height="18dp" />
            <solid android:color="@color/fireplace_ember" />
        </shape>
    </item>
</selector>
