<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat base avoids Leanback Browse chrome that only painted the title. -->
    <style name="Theme.FireplaceTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_browse</item>
        <item name="android:colorPrimary">@color/fireplace_ember</item>
        <item name="android:colorAccent">@color/fireplace_glow</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">@color/fireplace_ember</item>
        <item name="colorPrimaryDark">@color/fireplace_bg</item>
        <item name="colorAccent">@color/fireplace_glow</item>
    </style>

    <style name="Theme.FireplaceTV.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
