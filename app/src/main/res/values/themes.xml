<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Leanback parent keeps TV focus/selection attrs; we do not use BrowseSupportFragment. -->
    <style name="Theme.FireplaceTV" parent="Theme.Leanback">
        <item name="android:windowBackground">@drawable/bg_browse</item>
        <item name="android:colorPrimary">@color/fireplace_ember</item>
        <item name="android:colorAccent">@color/fireplace_glow</item>
        <item name="android:windowFullscreen">true</item>
        <item name="defaultBrandColor">@color/fireplace_bg_mid</item>
        <item name="defaultBrandColorDark">@color/fireplace_bg</item>
    </style>

    <style name="Theme.FireplaceTV.Player" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="SoundChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/sound_chip_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/fireplace_text</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
