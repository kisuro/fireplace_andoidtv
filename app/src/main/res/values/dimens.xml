<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Leanback window keyline + title margin (not HorizontalGridView padding).
      80dp (~8% of a 960dp-wide 1080p UI) — enough for focus stroke + TCL
      overscan without wide empty side gutters (160dp/14% was too wide).
      Runtime also floors at 7% of panel width.
    -->
    <dimen name="tv_safe_inset_horizontal">80dp</dimen>
    <!-- Kept for reference; horizontal focus inset is unused with NO_EDGE keyline. -->
    <dimen name="carousel_focus_inset">16dp</dimen>
    <dimen name="carousel_padding_vertical">36dp</dimen>
    <!-- Card chrome + focus stroke; image uses the same radius via clipToOutline. -->
    <dimen name="card_corner_radius">14dp</dimen>
    <!-- Hero fills leftover height; these floors keep it visible on short panels. -->
    <dimen name="hero_min_height">220dp</dimen>
    <dimen name="hero_image_min_height">180dp</dimen>
    <!-- Fixed carousel row so LinearLayout weight above cannot collapse to 0. -->
    <dimen name="carousel_row_height">200dp</dimen>
    <dimen name="carousel_card_width">200dp</dimen>
    <dimen name="carousel_image_height">112dp</dimen>
</resources>
