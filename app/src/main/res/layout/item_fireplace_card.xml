<?xml version="1.0" encoding="utf-8"?>
<!-- Thumb-only strip card — title/meta live on the hero, not under the carousel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="@dimen/carousel_card_width"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:longClickable="true"
    android:padding="4dp">

    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/carousel_image_height"
        android:background="@drawable/card_image_rounded"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/card_favorite_badge"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_favorite_badge"
        android:visibility="gone" />
</FrameLayout>
