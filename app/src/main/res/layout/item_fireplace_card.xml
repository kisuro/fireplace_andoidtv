<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="@dimen/carousel_card_width"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/carousel_image_height"
        android:background="@drawable/card_image_rounded"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/fireplace_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/fireplace_text_dim"
        android:textSize="11sp" />
</LinearLayout>
