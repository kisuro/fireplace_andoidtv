<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sound_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0B0705"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/sound_panel_card"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/sound_panel_card_bg"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/sound_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sound_panel_title"
            android:textColor="@color/fireplace_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sound_panel_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sound_panel_hint"
            android:textColor="@color/fireplace_text_dim"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sound_fireplace_crackle"
            android:textColor="@color/fireplace_text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/sound_crackle_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sound_crackle_on"
                style="@style/SoundChip"
                android:text="@string/sound_on" />

            <TextView
                android:id="@+id/sound_crackle_off"
                style="@style/SoundChip"
                android:layout_marginStart="10dp"
                android:text="@string/sound_off" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/sound_ambient"
            android:textColor="@color/fireplace_text_dim"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sound_ambient_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/sound_volume_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sound_volume_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sound_ambient_volume"
                android:textColor="@color/fireplace_text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/sound_volume_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fireplace_text"
                android:textSize="13sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sound_volume_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:max="20"
            android:minHeight="28dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:progressDrawable="@drawable/volume_seek_progress"
            android:thumb="@drawable/volume_seek_thumb" />

        <TextView
            android:id="@+id/sound_volume_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sound_volume_hint"
            android:textColor="@color/fireplace_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
