<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_browse"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingTop="36dp"
    android:paddingBottom="24dp">

    <!--
      Title start margin matches the Leanback window keyline (safe inset).
      Do not put that inset on HorizontalGridView horizontal padding —
      BOTH_EDGE + padding scrolled cards off-screen to the left.
    -->
    <TextView
        android:id="@+id/browse_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_safe_inset_horizontal"
        android:layout_marginEnd="@dimen/tv_safe_inset_horizontal"
        android:text="@string/browse_title"
        android:textColor="@color/fireplace_text"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/browse_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_safe_inset_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/tv_safe_inset_horizontal"
        android:text="@string/browse_subtitle"
        android:textColor="@color/fireplace_text_dim"
        android:textSize="18sp" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/video_carousel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingTop="@dimen/carousel_padding_vertical"
        android:paddingBottom="@dimen/carousel_padding_vertical" />

</LinearLayout>
