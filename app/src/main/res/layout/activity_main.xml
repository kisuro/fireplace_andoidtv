<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_browse"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="36dp"
    android:paddingEnd="0dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/browse_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:text="@string/browse_title"
        android:textColor="@color/fireplace_text"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/browse_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/browse_subtitle"
        android:textColor="@color/fireplace_text_dim"
        android:textSize="18sp" />

    <!-- ≥120dp horizontal padding so focus scale + orange halo on first/last
         cards stay fully on-screen (TCL MT5898 measured 48px still clipped). -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/video_carousel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="120dp"
        android:paddingEnd="120dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp" />

</LinearLayout>
