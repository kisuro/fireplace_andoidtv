<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_browse"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical"
    android:paddingTop="36dp"
    android:paddingBottom="24dp">

    <!--
      Title uses the same start inset as the carousel padding so the header
      aligns with left-edge cards. Do not rely on root horizontal padding —
      BOTH_EDGE only honors the grid's own padding when parking focused items.
    -->
    <TextView
        android:id="@+id/browse_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_safe_inset_horizontal"
        android:layout_marginEnd="@dimen/tv_safe_inset_horizontal"
        android:text="@string/browse_title"
        android:textColor="@color/fireplace_text"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/browse_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_safe_inset_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/tv_safe_inset_horizontal"
        android:text="@string/browse_subtitle"
        android:textColor="@color/fireplace_text_dim"
        android:textSize="18sp" />

    <!--
      Safe inset is the grid's horizontal padding so every left/right-parked
      focused card (not only index 0) keeps its orange stroke on-screen.
    -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/video_carousel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="@dimen/tv_safe_inset_horizontal"
        android:paddingEnd="@dimen/tv_safe_inset_horizontal"
        android:paddingTop="@dimen/carousel_padding_vertical"
        android:paddingBottom="@dimen/carousel_padding_vertical" />

</LinearLayout>
