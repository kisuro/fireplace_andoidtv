<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_browse"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_safe_inset_horizontal"
    android:paddingTop="36dp"
    android:paddingEnd="@dimen/tv_safe_inset_horizontal"
    android:paddingBottom="24dp">

    <!-- Margins come from main_root safe inset — do not add a second start margin. -->
    <TextView
        android:id="@+id/browse_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/browse_title"
        android:textColor="@color/fireplace_text"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/browse_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/browse_subtitle"
        android:textColor="@color/fireplace_text_dim"
        android:textSize="18sp" />

    <!--
      Root provides the TV safe inset. Grid keeps a small BOTH_EDGE focus inset
      so the orange stroke is not flush against the safe edge.
    -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/video_carousel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="@dimen/carousel_focus_inset"
        android:paddingEnd="@dimen/carousel_focus_inset"
        android:paddingTop="@dimen/carousel_padding_vertical"
        android:paddingBottom="@dimen/carousel_padding_vertical" />

</LinearLayout>
