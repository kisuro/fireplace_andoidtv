<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#990B0705"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/card_menu_card"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/sound_panel_card_bg"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/card_menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/fireplace_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/card_menu_hint"
            android:textColor="@color/fireplace_text_dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/card_menu_favorite"
            style="@style/SoundChip"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/card_menu_favorite_add" />

        <TextView
            android:id="@+id/card_menu_move"
            style="@style/SoundChip"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/card_menu_move" />

        <TextView
            android:id="@+id/card_menu_cancel"
            style="@style/SoundChip"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/card_menu_cancel" />
    </LinearLayout>
</FrameLayout>
